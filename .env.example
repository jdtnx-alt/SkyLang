# Base de datos PostgreSQL
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skylang

# Servidor Express
PORT=3001

# Clave de firma local. Cambiar por una clave propia en cada entorno.
JWT_SECRET=cambia_esta_clave_en_tu_entorno_local

# En desarrollo deja el sembrado activo para crear programa, fichas, usuarios demo y juegos.
SEED_ON_BOOT=true
SEED_DEMO_USERS=true

# Integraciones opcionales
GEMINI_API_KEY=
